# ── SafaiTrack environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. Every value below has a working default for
# local/offline demo, so the app runs with NO .env file at all.

# Database. Local file (offline-safe default) or a Turso libSQL URL for cloud.
DATABASE_URL=file:./data/safaitrack.db
# DATABASE_URL=libsql://safaitrack-<you>.turso.io
# DATABASE_AUTH_TOKEN=

# Session signing secret. CHANGE THIS before deploying.
JWT_SECRET=safaitrack-dev-secret-change-me-in-production

# API port
PORT=8080

# ── LLM Provider Configuration ─────────────────────────────────────────────
# SafaiTrack uses LLM only as an explanation layer for operational data.
# Deterministic fallback is automatic if no provider or API key is configured.
#
# Production Provider (OpenAI):
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Anthropic Provider (if configured):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Provider timing and token bounds:
LLM_TIMEOUT_MS=8000
LLM_MAX_OUTPUT_TOKENS=900

# Feature toggles for bounded explainers (default: true):
# LLM_ROUTE_EXPLAINER_ENABLED=true
# LLM_DASHBOARD_EXPLAINER_ENABLED=true

